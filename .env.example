# JT Chatons Studio - Configuration
# Copie ce fichier en .env et remplis ta clé API

# Clé API Agnes (obligatoire pour générer des vidéos)
# Obtiens ta clé sur https://platform.agnes-ai.com
AGNES_API_KEY=sk-votre-cle-ici

# Optionnel : rotation de plusieurs clés (séparées par des virgules)
# AGNES_API_KEYS=sk-cle-1,sk-cle-2,sk-cle-3

# Serveur local (optionnel)
PORT=8787
HOST=127.0.0.1

# Upstream Agnes (ne pas modifier sauf si nécessaire)
AGNES_UPSTREAM=https://apihub.agnes-ai.com